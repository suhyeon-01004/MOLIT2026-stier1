Panels:
  - Class: morai_kcity_hd_map/LocalizationStatusPanel
    Name: Localization Status Log
  - Class: rviz/Displays
    Name: Displays
  - Class: rviz/Selection
    Name: Selection
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.35
      Cell Size: 50
      Class: rviz/Grid
      Color: 80; 80; 80
      Enabled: true
      Name: Grid
      Plane: XY
      Plane Cell Count: 40
      Reference Frame: map
      Value: true
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /kcity_hd_map/markers
      Name: K-City HD Map
      Namespaces:
        crosswalks: true
        high_speed_centerlines_unlimited: true
        lane_boundary_dashed_white: true
        lane_boundary_dashed_yellow: true
        lane_boundary_solid_white: true
        lane_boundary_solid_yellow: true
        lane_change_allowed: true
        other_surface_markings: true
        regular_centerlines_60kmh: true
        stop_lines: true
        traffic_lights: true
      Queue Size: 1
      Value: true
    - Alpha: 0.75
      Buffer Length: 1
      Class: rviz/Path
      Color: 0; 220; 255
      Enabled: true
      Head Diameter: 0.3
      Head Length: 0.2
      Length: 0.3
      Line Style: Lines
      Line Width: 0.12
      Name: RDDF Lanelet2 Global Route
      Offset:
        X: 0
        Y: 0
        Z: 0.22
      Pose Color: 0; 220; 255
      Pose Style: None
      Radius: 0.03
      Shaft Diameter: 0.1
      Shaft Length: 0.1
      Topic: /global_path
      Value: true
    - Alpha: 1
      Buffer Length: 1
      Class: rviz/Path
      Color: 255; 110; 0
      Enabled: true
      Head Diameter: 0.3
      Head Length: 0.2
      Length: 0.3
      Line Style: Lines
      Line Width: 0.25
      Name: Vehicle Forward Local Path (100m)
      Offset:
        X: 0
        Y: 0
        Z: 0.28
      Pose Color: 255; 110; 0
      Pose Style: None
      Radius: 0.03
      Shaft Diameter: 0.1
      Shaft Length: 0.1
      Topic: /local_path
      Value: true
    - Alpha: 1
      Axes Length: 1
      Axes Radius: 0.1
      Class: rviz/Pose
      Color: 0; 255; 0
      Enabled: true
      Head Length: 1.2
      Head Radius: 0.6
      Name: Localized Vehicle Pose
      Shape: Arrow
      Shaft Length: 3
      Shaft Radius: 0.35
      Topic: /localization/pose
      Unreliable: false
      Value: true
    - Angle Tolerance: 0.1
      Class: rviz/Odometry
      Color: 255; 170; 0
      Enabled: true
      Keep: 20
      Name: Localization Odometry
      Position Tolerance: 0.1
      Shape: Arrow
      Topic: /localization/odometry
      Unreliable: false
      Value: true
    - Class: rviz/RobotModel
      Collision Enabled: false
      Enabled: true
      Name: IONIQ 5
      Robot Description: robot_description
      TF Prefix: ""
      Update Interval: 0
      Value: true
      Visual Enabled: true
    - Alpha: 0.45
      Class: rviz/PointCloud2
      Color: 120; 220; 150
      Color Transformer: FlatColor
      Decay Time: 0.0
      Enabled: true
      Name: LiDAR PointCloud (toggle)
      Position Transformer: XYZ
      Queue Size: 3
      Selectable: true
      Size (Pixels): 2
      Size (m): 0.04
      Style: Points
      Topic: /lidar3D
      Unreliable: false
      Use Fixed Frame: true
      Value: true
    - Class: rviz/TF
      Enabled: true
      Frame Timeout: 15
      Marker Scale: 1
      Name: Localization TF
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Update Interval: 0
      Value: true
  Enabled: true
  Global Options:
    Background Color: 25; 25; 25
    Default Light: true
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
  Value: true
  Views:
    Current:
      Angle: -1.5708
      Class: rviz/TopDownOrtho
      Name: Vehicle Follow
      Near Clip Distance: 0.01
      Scale: 5
      Target Frame: base_link
      X: 0
      Y: 0
    Saved: ~
Window Geometry:
  Height: 950
  Width: 1600
