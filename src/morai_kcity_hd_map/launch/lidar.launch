<launch>
  <!-- Reuse the original morai_bringup VLP-16 receiver; no control or localization nodes. -->
  <arg name="port" default="2368"/>
  <arg name="hz" default="10.0"/>
  <arg name="frame" default="lidar_link"/>
  <remap from="velodyne_packets" to="/sensors/lidar/packets"/>
  <remap from="velodyne_points" to="/lidar3D"/>
  <include file="$(find velodyne_driver)/launch/nodelet_manager.launch">
    <arg name="port" value="$(arg port)"/>
    <arg name="rpm" value="$(eval float(arg('hz')) * 60.0)"/>
    <arg name="frame_id" value="$(arg frame)"/>
    <arg name="model" value="VLP16"/>
    <arg name="manager" value="morai_lidar_nodelet_manager"/>
    <arg name="cut_angle" value="0.0"/>
    <arg name="gps_time" value="false"/>
  </include>
  <include file="$(find velodyne_pointcloud)/launch/transform_nodelet.launch">
    <arg name="model" value="VLP16"/>
    <arg name="calibration" value="$(find velodyne_pointcloud)/params/VLP16db.yaml"/>
    <arg name="manager" value="morai_lidar_nodelet_manager"/>
    <arg name="fixed_frame" value=""/>
    <arg name="target_frame" value=""/>
    <arg name="min_range" value="0.4"/>
    <arg name="max_range" value="130.0"/>
    <arg name="organize_cloud" value="false"/>
  </include>
</launch>
