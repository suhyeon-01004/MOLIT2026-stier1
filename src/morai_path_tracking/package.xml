<?xml version="1.0"?>
<package format="2">
  <name>morai_path_tracking</name>
  <version>0.1.0</version>
  <description>Pure Pursuit path tracking and longitudinal speed control for MORAI.</description>

  <maintainer email="stier@todo.todo">STIER</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <build_depend>message_generation</build_depend>
  <build_export_depend>message_runtime</build_export_depend>
  <exec_depend>message_runtime</exec_depend>
  <exec_depend>python3-matplotlib</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <depend>morai_udp_bridge</depend>
  <depend>geometry_msgs</depend>
  <depend>message_filters</depend>
  <depend>osqp_vendor</depend>
  <depend>nav_msgs</depend>
  <depend>roscpp</depend>
  <depend>std_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_geometry_msgs</depend>

  <test_depend>gtest</test_depend>
  <test_depend>morai_localization</test_depend>
  <test_depend>python3-nose</test_depend>
  <test_depend>python3-yaml</test_depend>
  <test_depend>rostest</test_depend>
  <test_depend>rospy</test_depend>

  <export/>
</package>
