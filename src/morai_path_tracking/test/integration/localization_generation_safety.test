<launch>
  <node pkg="morai_localization"
        type="localization_fusion_node"
        name="generation_localization_fusion"
        output="screen">
    <param name="gps_local_topic" value="/generation_test/gps"/>
    <param name="imu_output_topic" value="/generation_test/imu"/>
    <param name="pose_topic" value="/generation_test/pose"/>
    <param name="odometry_topic" value="/generation_test/odometry"/>
    <param name="frame_id" value="map"/>
    <param name="imu_frame_id" value="imu_link"/>
    <param name="base_frame_id" value="base_link"/>
    <param name="tf_child_frame_id" value="base_footprint"/>
    <param name="publish_tf" value="false"/>
    <param name="max_sensor_skew_sec" value="0.2"/>
    <param name="max_gps_age_sec" value="1.0"/>
    <param name="max_imu_age_sec" value="1.0"/>
    <param name="minimum_velocity_dt_sec" value="0.005"/>
    <param name="maximum_velocity_dt_sec" value="0.25"/>
    <param name="maximum_velocity_mps" value="50.0"/>
    <param name="velocity_filter_time_constant_sec" value="0.0"/>
  </node>

  <node pkg="morai_path_manager"
        type="route_path_publisher_node"
        name="generation_route_path_publisher"
        output="screen">
    <param name="path_file"
           value="$(find morai_path_tracking)/test/data/controller_integration_route.txt"/>
    <param name="localization_topic" value="/generation_test/pose"/>
    <param name="global_path_topic" value="/generation_test/global_path"/>
    <param name="local_path_topic" value="/generation_test/local_path"/>
    <param name="frame_id" value="map"/>
    <param name="local_path_mode" value="point_count"/>
    <param name="local_path_point_count" value="3"/>
    <param name="local_path_length_m" value="20.0"/>
    <param name="search_backward_m" value="20.0"/>
    <param name="search_forward_m" value="200.0"/>
    <param name="reacquire_distance_m" value="10.0"/>
    <param name="max_path_point_spacing_m" value="20.0"/>
    <param name="flatten_z" value="true"/>
    <param name="require_closed_loop" value="true"/>
  </node>

  <node pkg="morai_path_tracking"
        type="path_tracking_controller_node"
        name="generation_pure_pursuit_controller"
        output="screen">
    <param name="local_path_topic" value="/generation_test/local_path"/>
    <param name="odometry_topic" value="/generation_test/odometry"/>
    <param name="vehicle_status_topic"
           value="/generation_test/competition_status"/>
    <param name="command_topic" value="/generation_test/command"/>
    <param name="controller_status_topic"
           value="/generation_test/controller_status"/>
    <param name="lookahead_point_topic"
           value="/generation_test/lookahead_point"/>
    <param name="stanley_projection_point_topic"
           value="/generation_test/stanley_projection_point"/>
    <param name="expected_frame_id" value="map"/>
    <param name="expected_velocity_frame_id" value="base_link"/>
    <param name="control_rate_hz" value="30.0"/>
    <param name="path_timeout_sec" value="0.25"/>
    <param name="odometry_timeout_sec" value="0.25"/>
    <param name="vehicle_status_timeout_sec" value="0.25"/>
    <param name="maximum_input_skew_sec" value="0.0"/>
    <param name="input_sync_queue_size" value="10"/>
    <param name="minimum_control_dt_sec" value="0.005"/>
    <param name="maximum_control_dt_sec" value="0.10"/>
    <param name="safe_brake_command" value="0.50"/>
    <param name="wheelbase_m" value="3.0"/>
    <param name="vehicle_width_m" value="1.892"/>
    <param name="lane_half_width_m" value="1.30"/>
    <param name="lane_clearance_recovery_start_m" value="0.18"/>
    <param name="lane_clearance_recovery_full_m" value="0.05"/>
    <param name="lane_clearance_recovery_speed_kph" value="3.0"/>
    <param name="heading_error_speed_limit_start_deg" value="4.0"/>
    <param name="heading_error_speed_limit_full_deg" value="10.0"/>
    <param name="heading_error_recovery_speed_kph" value="3.0"/>
    <param name="lookahead_base_m" value="3.0"/>
    <param name="lookahead_speed_gain_sec" value="0.5"/>
    <param name="lookahead_curvature_gain_m" value="5.0"/>
    <param name="lookahead_min_m" value="3.0"/>
    <param name="lookahead_max_m" value="6.0"/>
    <param name="minimum_target_distance_m" value="0.5"/>
    <param name="maximum_steering_angle_deg" value="40.0"/>
    <param name="lateral_controller" value="pure_pursuit"/>
    <param name="stanley_gain" value="2.0"/>
    <param name="stanley_softening_speed_mps" value="1.0"/>
    <param name="stanley_minimum_control_speed_mps" value="1.0"/>
    <param name="stanley_heading_window_m" value="4.0"/>
    <param name="stanley_heading_error_gain" value="0.5"/>
    <param name="stanley_curvature_feedforward_gain" value="1.0"/>
    <param name="stanley_curvature_preview_distance_m" value="8.0"/>
    <param name="stanley_yaw_rate_damping_gain_sec" value="0.1"/>
    <param name="stanley_yaw_rate_damping_nonlinear_gain_sec2" value="0.5"/>
    <param name="stanley_maximum_steering_rate_deg_per_sec" value="180.0"/>
    <param name="hybrid_mass_kg" value="2000.0"/>
    <param name="hybrid_yaw_inertia_kgm2" value="4000.0"/>
    <param name="hybrid_front_cornering_stiffness_n_per_rad" value="60000.0"/>
    <param name="hybrid_rear_cornering_stiffness_n_per_rad" value="60000.0"/>
    <param name="hybrid_front_axle_to_cg_m" value="1.5"/>
    <param name="hybrid_rear_axle_to_cg_m" value="1.5"/>
    <param name="hybrid_process_noise_sideslip" value="0.1"/>
    <param name="hybrid_process_noise_yaw_rate" value="0.01"/>
    <param name="hybrid_measurement_noise_sideslip" value="0.001"/>
    <param name="hybrid_measurement_noise_yaw_rate" value="0.001"/>
    <param name="hybrid_initial_covariance_sideslip" value="0.1"/>
    <param name="hybrid_initial_covariance_yaw_rate" value="0.01"/>
    <param name="hybrid_initial_pure_pursuit_probability" value="0.8"/>
    <param name="hybrid_initial_stanley_probability" value="0.2"/>
    <param name="hybrid_stanley_probability_min" value="0.15"/>
    <param name="hybrid_stanley_probability_max" value="0.90"/>
    <param name="hybrid_transition_pure_pursuit_to_pure_pursuit" value="0.9"/>
    <param name="hybrid_transition_pure_pursuit_to_stanley" value="0.1"/>
    <param name="hybrid_transition_stanley_to_pure_pursuit" value="0.95"/>
    <param name="hybrid_transition_stanley_to_stanley" value="0.05"/>
    <param name="hybrid_transition_speed_gain" value="0.1"/>
    <param name="hybrid_transition_reference_speed_kph" value="60.0"/>
    <param name="hybrid_minimum_model_speed_mps" value="1.0"/>
    <param name="hybrid_pure_pursuit_cross_track_correction_gain" value="0.5"/>
    <param name="hybrid_curve_preview_stanley_weight_start_m_inv" value="0.02"/>
    <param name="hybrid_curve_preview_stanley_weight_full_m_inv" value="0.06"/>
    <param name="hybrid_curve_preview_stanley_minimum_weight" value="0.0"/>
    <param name="hybrid_heading_lag_stanley_weight_start_deg" value="8.0"/>
    <param name="hybrid_heading_lag_stanley_weight_full_deg" value="14.0"/>
    <param name="hybrid_heading_lag_stanley_minimum_weight" value="0.0"/>
    <param name="hybrid_candidate_conflict_curvature_threshold_m_inv" value="0.015"/>
    <param name="hybrid_candidate_conflict_cross_track_threshold_m" value="0.45"/>
    <param name="hybrid_cross_track_recovery_full_scale_m" value="0.50"/>
    <param name="hybrid_cross_track_recovery_heading_error_suppression_start_deg" value="15.0"/>
    <param name="hybrid_cross_track_recovery_heading_error_suppression_full_deg" value="17.5"/>
    <param name="hybrid_cross_track_recovery_heading_error_maximum_suppression_ratio" value="0.30"/>
    <param name="hybrid_maximum_steering_rate_deg_per_sec" value="180.0"/>
    <param name="hybrid_low_curvature_maximum_steering_rate_deg_per_sec" value="180.0"/>
    <param name="hybrid_full_steering_rate_curvature_m_inv" value="0.02"/>
    <param name="hybrid_steering_return_rate_multiplier" value="2.0"/>
    <param name="target_speed_kph" value="10.8"/>
    <param name="minimum_curve_speed_kph" value="3.0"/>
    <param name="maximum_lateral_acceleration_mps2" value="1.5"/>
    <param name="curvature_speed_reduction_gain_m" value="0.0"/>
    <param name="curvature_preview_distance_m" value="20.0"/>
    <param name="lookahead_curvature_preview_distance_m" value="8.0"/>
    <param name="curvature_sample_spacing_m" value="0.5"/>
    <param name="curve_approach_deceleration_mps2" value="3.0"/>
    <param name="curvature_epsilon_m_inv" value="0.001"/>
    <param name="target_speed_acceleration_limit_mps2" value="1.0"/>
    <param name="curve_target_speed_acceleration_limit_mps2" value="0.5"/>
    <param name="target_speed_deceleration_limit_mps2" value="2.0"/>
    <param name="target_speed_filter_time_constant_sec" value="0.0"/>
    <param name="speed_filter_time_constant_sec" value="0.0"/>
    <param name="speed_kp" value="0.35"/>
    <param name="speed_ki" value="0.08"/>
    <param name="speed_kd" value="0.02"/>
    <param name="speed_integral_limit" value="2.0"/>
    <param name="speed_integral_unwind_rate_per_sec" value="0.5"/>
    <param name="speed_error_deadband_mps" value="0.05"/>
    <param name="speed_accel_feedforward_gain_per_mps" value="0.0"/>
    <param name="speed_coast_overspeed_kph" value="0.2"/>
    <param name="speed_brake_overspeed_kph" value="1.8"/>
    <param name="hard_brake_activation_speed_kph" value="59.0"/>
    <param name="minimum_hard_brake_command" value="0.25"/>
    <param name="maximum_accel_command" value="0.40"/>
    <param name="maximum_brake_command" value="0.60"/>
    <param name="longitudinal_command_rate_limit_per_sec" value="0.0"/>
  </node>

  <test test-name="localization_generation_safety"
        pkg="morai_path_tracking"
        type="test_localization_generation_safety.py"
        time-limit="30.0"/>
</launch>
